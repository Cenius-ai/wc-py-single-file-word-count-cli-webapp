# wc-py environment variables (all optional).
#
# wc.py itself reads NO environment variables and no .env file: it needs no
# configuration to run. These two shell variables are honoured only by the
# helper scripts (demo.sh, install.sh). Export them in your shell, or copy this
# file to .env and `set -a; . ./.env; set +a` if you prefer.
#
# Leave a value EMPTY to accept the script's default.

# Disable ANSI colour in demo.sh output (NO_COLOR convention). Empty = colour on for a TTY.
NO_COLOR=

# Interpreter used by demo.sh and install.sh. Empty = python3 from PATH.
PYTHON=
